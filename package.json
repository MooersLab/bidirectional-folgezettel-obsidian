{
    "name": "bidirectional-folgezettel",
    "version": "1.2.2",
    "description": "Automatic bidirectional linking for folgezettel-style note addresses in Obsidian",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "npx tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
        "test": "npx jest",
        "test:coverage": "npx jest --coverage",
        "lint": "npx eslint . --ext .ts",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "folgezettel",
        "zettelkasten",
        "bidirectional-links"
    ],
    "author": "Blaine Mooers",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "@types/node": "^20.11.5",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "builtin-modules": "^3.3.0",
        "esbuild": "^0.19.11",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "obsidian": "latest",
        "ts-jest": "^29.1.2",
        "tslib": "^2.6.2",
        "typescript": "^5.3.3"
    }
}
